# SoloOS Environment Configuration

# Client-side Supabase configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Server-side Supabase configuration (for SSR/Nitro runtime)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Application Base URL (for email invitation and return links)
APP_BASE_URL="http://localhost:3000"

# AI CFO Configuration (Phase 8 - Grounded, Read-Only Financial Assistant)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# PayChangu Payment Gateway (Phase 9 - Launch Pricing: MWK 14k/21k, USD 8/12)
PAYCHANGU_SECRET_KEY="sec-test-your-paychangu-secret-key"
PAYCHANGU_PUBLIC_KEY="pub-test-your-paychangu-public-key"

# Email Provider Configuration (Phase 9 - Resend Integration)
# If left blank, NullEmailProvider safely suppresses outgoing emails without errors
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="SoloOS <notifications@soloos.app>"

# Cron secret for automated reconciliations and scheduled tasks
CRON_SECRET="your-cron-secret-token"
